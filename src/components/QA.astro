---
/**
 * 单条面试问答：详情折叠块。
 * answer 允许内联少量 HTML（<b> <code> <br> <ul>），因为答案的排版需要强调与分行。
 */
interface Props {
  q: string;
  answer: string;
  hint?: string;
  followups?: string[];
  freq?: 'high' | 'mid';
  open?: boolean;
}

const { q, answer, hint, followups = [], freq = 'mid', open = false } = Astro.props;
---

<details class="qa" open={open}>
  <summary>
    {q}
    {freq === 'high' && <span class="badge lv3" style="margin-left:8px;vertical-align:2px">高频</span>}
  </summary>
  <div class="qa-body">
    <div set:html={answer} />
    {
      followups.length > 0 && (
        <div class="followup">
          <p style="font-family:var(--font-ui);font-size:.66rem;letter-spacing:.14em;text-transform:uppercase;color:var(--ink-muted);margin:0 0 6px">
            追问链
          </p>
          <ol>
            {followups.map((f) => (
              <li set:html={f} />
            ))}
          </ol>
        </div>
      )
    }
    {hint && <span class="qa-hint"><b>加分点：</b>{hint}</span>}
  </div>
</details>
