---
/**
 * 报头：全站统一。
 * compact = true 时只保留顶部细条与双线，用于章节页（把版面让给正文）。
 */
interface Props {
  compact?: boolean;
  kicker?: string;
  title?: string;
  en?: string;
}

const { compact = false, kicker, title, en } = Astro.props;
const buildDate = new Date();
const buildLabel = `${buildDate.getFullYear()}年${buildDate.getMonth() + 1}月${buildDate.getDate()}日`;
---

<div class="masthead" data-masthead>
  <div class="masthead-top">
    <span class="vol">学习报 · 第 <span data-issue>1</span> 期</span>
    <span data-today>{buildLabel}</span>
    <span>杭州 · 电子版 · 免费</span>
  </div>

  {
    !compact && (
      <div class="masthead-title">
        <h1>Harness Times</h1>
        <div class="cn">HARNESS 与 AGENT 工程学习报</div>
      </div>
    )
  }

  <div class="masthead-rule"></div>

  {
    compact && (title || kicker) && (
      <div class="masthead-bottom">
        {kicker && <span class="vol">{kicker}</span>}
        {kicker && title && <span class="sep">◆</span>}
        {title && <span>{title}</span>}
        {en && <span class="sep">◆</span>}
        {en && <span>{en}</span>}
      </div>
    )
  }

  {
    !compact && (
      <div class="masthead-bottom">
        <span>原理</span>
        <span class="sep">◆</span>
        <span>工程</span>
        <span class="sep">◆</span>
        <span>评测</span>
        <span class="sep">◆</span>
        <span>知识</span>
      </div>
    )
  }
</div>

<script>
  // 报头日期与期号在客户端计算：静态站构建日期会被冻结，读者看到的应该是"今天"。
  const pad = (n: number) => String(n).padStart(2, '0');
  const d = new Date();
  const week = ['日', '一', '二', '三', '四', '五', '六'][d.getDay()];
  const label = `${d.getFullYear()}年${d.getMonth() + 1}月${d.getDate()}日 · 星期${week}`;
  const todayEl = document.querySelector('[data-today]');
  if (todayEl) todayEl.textContent = label;

  // 期号 = 自站点起始日算起的天数，让"第 N 期"每天都会变，符合日报直觉
  const epoch = Date.UTC(2026, 0, 1);
  const now = Date.UTC(d.getFullYear(), d.getMonth(), d.getDate());
  const issue = Math.max(1, Math.floor((now - epoch) / 86400000) + 1);
  document.querySelectorAll('[data-issue]').forEach((el) => {
    el.textContent = String(issue);
  });

  // 侧栏报头里的期号（如果有）
  const sd = document.querySelector('[data-issue-side]');
  if (sd) sd.textContent = `第 ${issue} 期 · ${pad(d.getMonth() + 1)}/${pad(d.getDate())}`;
</script>
