---
/**
 * 报头：全站统一。
 * compact = true 时只保留顶部细条与双线，用于章节页（把版面让给正文）。
 *
 * 这里刻意不放「第 N 期」这种期号：本站在意图上是一个可以反复回来读的
 * 学习站，内容按「章」组织、随修订更新，而不是每天换一期的报刊。
 * 顶部细条只说清楚三件事——这是什么站、谁做的、怎么用。
 */
interface Props {
  compact?: boolean;
  kicker?: string;
  title?: string;
  en?: string;
}

const { compact = false, kicker, title, en } = Astro.props;
---

<div class="masthead" data-masthead>
  <div class="masthead-top">
    <span class="vol">Agent 工程学习站</span>
    <span class="made-by">
      做棵大树 出品
      <a class="site-link" href="https://beatree.cn" target="_blank" rel="noopener">
        主站 beatree.cn<span aria-hidden="true">↗</span>
      </a>
    </span>
    <span>免费 · 无需登录 · 进度存本机</span>
  </div>

  {
    !compact && (
      <div class="masthead-title">
        <h1>Harness Times</h1>
        <div class="cn">HARNESS 与 AGENT 工程学习站</div>
      </div>
    )
  }

  <div class="masthead-rule"></div>

  {
    compact && (title || kicker) && (
      <div class="masthead-bottom">
        {kicker && <span class="vol">{kicker}</span>}
        {kicker && title && <span class="sep">◆</span>}
        {title && <span>{title}</span>}
        {en && <span class="sep">◆</span>}
        {en && <span>{en}</span>}
      </div>
    )
  }

  {
    !compact && (
      <div class="masthead-bottom">
        <span>原理</span>
        <span class="sep">◆</span>
        <span>工程</span>
        <span class="sep">◆</span>
        <span>评测</span>
        <span class="sep">◆</span>
        <span>知识</span>
      </div>
    )
  }
</div>
