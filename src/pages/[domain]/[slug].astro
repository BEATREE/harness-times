---
import { getCollection, render } from 'astro:content';
import ChapterLayout from '../../layouts/ChapterLayout.astro';
import InterviewSection from '../../components/InterviewSection.astro';
import { DOMAINS, chapterById, domainOf } from '../../data/curriculum';
import { collectTermIds } from '../../lib/glossary-terms';

export async function getStaticPaths() {
  const entries = await getCollection('chapters');
  const known = new Set(DOMAINS.map((d) => d.id));

  return entries.map((entry) => {
    const chapter = chapterById(entry.id);
    if (!chapter) {
      // 内容文件与 curriculum.ts 失同步时，直接让构建失败，而不是产出一个空页面
      throw new Error(
        `[content] src/content/chapters/${entry.id}.md 在 curriculum.ts 中没有对应章节，` +
          `请先在 CHAPTERS 中登记或改正文件名。`
      );
    }
    if (!known.has(chapter.domain)) {
      throw new Error(`[content] ${entry.id} 引用了未知领域 ${chapter.domain}`);
    }
    return {
      params: { domain: chapter.domain, slug: chapter.id },
      props: { chapter, entry },
    };
  });
}

const { chapter, entry } = Astro.props;
const { Content } = await render(entry);
const domain = domainOf(chapter.domain);

/*
 * 本章正文里出现过哪些术语标记（[[id]]）。
 * 只把这几个名词的卡片渲染进页面 —— 名词库有几十上百条，
 * 整库塞进每一页会让 HTML 白胖一圈，而读者在单章里点不到那些没出现的名词。
 * entry.body 是 glob loader 给的原始 markdown（不含 frontmatter）。
 */
const termIds = collectTermIds(entry.body ?? '');
---

<ChapterLayout
  chapter={chapter}
  domain={domain}
  lead={entry.data.lead}
  note={entry.data.note}
  termIds={termIds}
>
  <Content />

  <InterviewSection chapterId={chapter.id} />
</ChapterLayout>
