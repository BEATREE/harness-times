---
import '../styles/global.css';
import Sidebar from '../components/Sidebar.astro';

interface Props {
  title: string;
  description?: string;
  currentChapter?: string;
  currentDomain?: string;
  /** 当前章节 id，会写到 body[data-chapter] 供客户端脚本读取 */
  chapterId?: string;
  /** 页面副标题，用于 <title> 后缀 */
  suffix?: string;
}

const {
  title,
  description = 'Harness Times —— 系统学习 Harness 工程、评测工程、知识引擎与大模型原理的中文学习站。包含原理图解、实操代码与面试问答，学习进度保存在本机浏览器。',
  currentChapter,
  currentDomain,
  chapterId,
} = Astro.props;

const fullTitle = title === 'Harness Times' ? title : `${title} · Harness Times`;
/* 兜底值与 astro.config.mjs 的 site 保持一致：canonical 必须是「对外主张的地址」，
 * 否则两个域名各被收录一份，权重被摊薄。 */
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://harness.beatree.cn').href;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#f4efe6" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
  </head>
  <body class="is-entering" data-chapter={chapterId}>
    <div class="app">
      <Sidebar currentChapter={currentChapter} currentDomain={currentDomain} />
      <div class="main paper-texture">
        <!--
          正文两侧的大翻页区（只有章节页提供，其余页面这两个 slot 为空）。
          它们必须是 .sheet 的**兄弟节点**而不是子节点：≥1300px 时 .main 是三栏 flex
          （rail-prev | .sheet | rail-next），翻页区要占据正文纸面之外的空间。
        -->
        <slot name="rail-prev" />
        <div class="sheet">
          <slot />
          <footer class="site-foot">
            <span>
              Harness Times · Harness 与 Agent 工程学习站 · 由「做棵大树」维护<br />
              学习进度保存在本机浏览器，不会上传任何数据
            </span>
            <span>
              <a href="/progress/">学习进度</a> ·
              <a href="/interview/">面试题总览</a> ·
              <a href="/about/">关于本站</a> ·
              <a href="https://beatree.cn" target="_blank" rel="noopener">beatree.cn</a>
            </span>
          </footer>
        </div>
        <slot name="rail-next" />
      </div>
    </div>

    <!--
      浮层（目前是名词卡片弹窗）挂在 .app **之外**。
      原因：章节页的默认 slot 落在 <article class="prose"> 里面，
      浮层若跟着进去，卡片就会被正文排版规则（.prose p / a / h3）串味，
      而且正文里的相对定位/溢出规则也会影响它。浮层本来就该在最外层。
    -->
    <slot name="overlay" />

    <div class="toast" data-toast role="status" aria-live="polite"></div>

    <script>
      import { load } from '../lib/progress';

      // —— 换页过渡：入场由 body 上的 is-entering 触发，离场靠拦截站内链接 ——
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (!reduced) {
        // 注意：绝对不能在这里立刻 remove('is-entering')。
        // 这个 class 写在 HTML 上，浏览器要在首帧计算样式时才会起播 paperEnter；
        // 而模块脚本跑得比首帧更早，立刻摘掉等于把入场动画直接掐死
        //——之前「只看到灰屏闪一下、看不到入场」就有这个原因。
        // 正确做法是等动画演完再摘，顺便避免从 bfcache 返回时重播。
        window.setTimeout(() => document.body.classList.remove('is-entering'), 400);

        document.addEventListener('click', (e) => {
          if (e.defaultPrevented || e.button !== 0) return;
          if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;

          const a = (e.target as HTMLElement)?.closest?.('a');
          if (!a) return;
          const href = a.getAttribute('href');
          if (!href) return;
          if (a.target === '_blank' || a.hasAttribute('download')) return;
          if (href.startsWith('#') || href.startsWith('mailto:') || href.startsWith('http')) return;
          if (a.hasAttribute('data-no-transition')) return;

          const url = new URL(a.href, location.href);
          if (url.origin !== location.origin) return;
          if (url.pathname === location.pathname && url.hash) return;

          e.preventDefault();
          document.body.classList.add('is-leaving');
          // 与 paperExit 的 180ms 对齐，留一点余量即可
          window.setTimeout(() => {
            location.href = url.href;
          }, 190);
        });
      } else {
        document.body.classList.remove('is-entering');
      }

      // —— 全局提示条 ——
      const toastEl = document.querySelector('[data-toast]');
      let toastTimer: number | undefined;
      (window as any).htToast = (msg: string) => {
        if (!toastEl) return;
        toastEl.textContent = msg;
        toastEl.classList.add('show');
        window.clearTimeout(toastTimer);
        toastTimer = window.setTimeout(() => toastEl.classList.remove('show'), 2200);
      };

      // —— 开启本机存储的说明：首次访问给一次提示 ——
      try {
        const seen = window.localStorage.getItem('ht:welcomed');
        if (!seen) {
          window.localStorage.setItem('ht:welcomed', '1');
          setTimeout(() => (window as any).htToast?.('进度会自动保存在本机浏览器'), 900);
        }
      } catch {
        /* 隐私模式下 localStorage 不可用，忽略 */
      }

      // 预热存储层，让首次写入就建立结构
      load();
    </script>
  </body>
</html>
