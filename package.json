{
  "name": "harness-times",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "description": "Harness Times · Harness 与 Agent 工程学习站 — 一份可以按章读下去的中文学习站",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "content:check": "node scripts/normalize-content.mjs --check",
    "content:fix": "node scripts/normalize-content.mjs --fix",
    "prebuild": "npm run content:check",
    "build": "astro build",
    "clean": "node scripts/clean.mjs",
    "build:fresh": "npm run clean && astro build",
    "preview": "astro preview",
    "serve": "astro preview --host 0.0.0.0",
    "deploy": "npm run build:fresh && node scripts/deploy.mjs",
    "deploy:only": "node scripts/deploy.mjs",
    "cf:whoami": "wrangler whoami",
    "cf:login": "wrangler login",
    "cf:domain": "node scripts/cf-domain.mjs status",
    "verify": "node tools/verify.mjs",
    "verify:live": "node tools/verify.mjs --base=https://harness.beatree.cn",
    "verify:build": "node scripts/verify-build.mjs",
    "wiki:facts": "node scripts/wiki-facts.mjs",
    "wiki:lint": "node scripts/wiki-lint.mjs",
    "audit": "node tools/audit.mjs",
    "probe": "node tools/probe.mjs",
    "bisect": "node tools/bisect.mjs"
  },
  "dependencies": {
    "astro": "^5.14.1"
  },
  "engines": {
    "node": ">=18.17.1"
  },
  "devDependencies": {
    "wrangler": "^4.133.0"
  }
}
